VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional built-in AI keys (used when a user has not saved their own)
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=

# Free OpenRouter models used for auto-switch when a selected model errors
VITE_OPENROUTER_SWITCHING_MODELS=google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash-vl:free,nex-agi/nex-n2.5-mini:free
